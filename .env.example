# Node environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Bot owner (required)
OWNER_PHONE=1234567890

# Command prefix (optional, default: /)
COMMAND_PREFIX=/

# Database (required)
SUPABASE_URL=https://abc.supabase.co
SUPABASE_KEY=your-anon-key-here

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Chrome/Chromium path (optional, puppeteer's bundled Chromium if not set)
CHROME_PATH=

# Spotify API (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Imgur API (optional)
IMGUR_CLIENT_ID=
