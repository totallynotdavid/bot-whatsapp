# Required
OWNER_PHONE=1234567890
SUPABASE_URL=https://abc.supabase.co
SUPABASE_KEY=your-anon-key-here

# Optional, with default. Omit the line to use the default.
# NODE_ENV=production
# LOG_LEVEL=info
# COMMAND_PREFIX=/
# REDIS_HOST=localhost
# REDIS_PORT=6379
# AWS_REGION=us-east-1

# Optional, no default. Omit the line if you don't use the feature.
# CHROME_PATH=/usr/bin/chromium
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# IMGUR_CLIENT_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
