{
  "name": "bot-whatsapp",
  "version": "1.9.7",
  "private": true,
  "description": "Bots de WhatsApp del operador, con transportes intercambiables",
  "author": "totallynotdavid",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "fix": "oxlint -c .oxlintrc.json --fix . && oxfmt .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings . && oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun --bun vitest run",
    "clean": "bun run clean:logs && bun run --filter '@bot-whatsapp/whatsapp-bot' clean:session:dev && bun run clean:packages && bun install --frozen-lockfile",
    "clean:logs": "shx rm -rf ~/.pm2/logs",
    "clean:packages": "shx rm -rf node_modules",
    "start": "bun run --filter '@bot-whatsapp/whatsapp-bot' start",
    "start:prod": "bun run --filter '@bot-whatsapp/whatsapp-bot' start:prod"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "canvas": "^3.2.3"
  }
}
