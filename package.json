{
  "name": "whatsapp-bot",
  "description": "Un bot de WhatsApp multifuncional",
  "version": "1.9.7",
  "author": "totallynotdavid",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:prod": "pm2 start \"bun src/main.ts\" --name whatsapp-bot --cron-restart=\"0 */4 * * *\" && bun run logs",
    "clean": "bun run clean:logs && bun run clean:mundane && bun run clean:packages && bun run clean:session && bun i",
    "clean:logs": "shx rm -rf ~/.pm2/logs",
    "clean:mundane": "shx rm -rf music logs.txt",
    "clean:packages": "shx rm -rf node_modules",
    "clean:session:dev": "shx rm -rf .wwebjs_auth .wwebjs_cache",
    "clean:session:prod": "shx rm -rf .wwebjs_auth",
    "logs": "pm2 log",
    "format": "oxfmt src tests",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src tests",
    "test": "bun --bun vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "bullmq": "^6.3.8",
    "cheerio": "^1.2.0",
    "discord-image-generation": "^1.4.25",
    "fluent-ffmpeg": "^2.1.3",
    "imgur": "^2.6.1",
    "ioredis": "^6.0.0",
    "uuid": "14.0.2",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "canvas": "^3.2.3"
  }
}
