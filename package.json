{
  "name": "bot-whatsapp",
  "version": "1.9.7",
  "private": true,
  "description": "Bots de WhatsApp del operador, con transportes intercambiables",
  "author": "totallynotdavid",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "bun run clean:logs && bun run clean:mundane && bun run clean:packages && bun run --filter '@bot-whatsapp/whatsapp-bot' clean:session:dev && bun i",
    "clean:logs": "shx rm -rf ~/.pm2/logs",
    "clean:mundane": "shx rm -rf music logs.txt",
    "clean:packages": "shx rm -rf node_modules",
    "format": "oxfmt .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings .",
    "test": "bun --bun vitest run",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "canvas": "^3.2.3"
  }
}
