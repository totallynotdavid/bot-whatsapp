{
  "name": "whatsapp-bot",
  "description": "Un bot de WhatsApp multifuncional",
  "version": "1.9.7",
  "author": "totallynotdavid",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts --env-file=.env",
    "start:prod": "pm2 start bot/main.js --cron-restart=\"0 */4 * * *\" && bun run logs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "clean": "bun run clean:logs && bun run clean:mundane && bun run clean:packages && bun run clean:session && bun i",
    "clean:logs": "shx rm -rf ~/.pm2/logs",
    "clean:mundane": "shx rm -rf music logs.txt",
    "clean:packages": "shx rm -rf node_modules",
    "clean:session:dev": "shx rm -rf .wwebjs_auth .wwebjs_cache",
    "clean:session:prod": "shx rm -rf .wwebjs_auth",
    "logs": "pm2 log",
    "format": "biome format --write . && biome check --write . && bun x prettier \"**/*.{md,yml}\" --write --print-width=80 --prose-wrap=always"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.370.0",
    "@google-cloud/local-auth": "^2.1.0",
    "@supabase/supabase-js": "^2.86.0",
    "@totallynodavid/downloader": "^2.0.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitalets/google-translate-api": "^9.2.1",
    "bimg": "^0.1.5",
    "bullmq": "^5.65.0",
    "discord-image-generation": "^1.4.25",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^105.0.0",
    "imgur": "^2.3.0",
    "ioredis": "^5.8.2",
    "lodash": "^4.17.21",
    "node-fetch": "^2.6.7",
    "openai": "^6.9.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "spotify-web-api-node": "^5.0.2",
    "sqlite3": "^5.1.6",
    "uuid": "^13.0.0",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js#5438c2042b9b42370c0acef21e511c08bb462983",
    "yt_duration": "^0.0.2",
    "yt_metadata": "^0.0.5",
    "ytdlp_video_processor": "^0.0.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  }
}
