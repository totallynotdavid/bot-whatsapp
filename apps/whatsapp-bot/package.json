{
  "name": "@bot-whatsapp/whatsapp-bot",
  "version": "1.9.7",
  "private": true,
  "description": "Un bot de WhatsApp multifuncional",
  "author": "totallynotdavid",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:prod": "pm2 start \"bun src/main.ts\" --name whatsapp-bot --exp-backoff-restart-delay=1000 && bun run logs",
    "clean:session:dev": "shx rm -rf .wwebjs_auth .wwebjs_cache .baileys_auth",
    "clean:session:prod": "shx rm -rf .wwebjs_auth .baileys_auth",
    "logs": "pm2 log",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1152.0",
    "@bot-whatsapp/whatsapp": "workspace:*",
    "@bot-whatsapp/whatsapp-baileys": "workspace:*",
    "@bot-whatsapp/whatsapp-wwebjs": "workspace:*",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "2.118.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "bullmq": "^6.3.16",
    "cheerio": "^1.2.0",
    "discord-image-generation": "^1.4.25",
    "fluent-ffmpeg": "^2.1.3",
    "imgur": "^2.6.1",
    "ioredis": "^6.0.0",
    "puppeteer": "^25.14.0",
    "uuid": "14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "shx": "^0.4.0"
  }
}
