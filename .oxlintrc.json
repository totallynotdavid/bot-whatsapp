{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "node", "promise", "typescript", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // A leading underscore marks an intentionally-unused binding throughout
    // this codebase (catch clauses, unused query params in fakes).
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // Retry backoff and rate-limited downloads need each iteration to
    // finish before the next one starts.
    "eslint/no-await-in-loop": "off",
    // `_serialized` and friends are whatsapp-web.js's own field names, not
    // this codebase's naming choice.
    "eslint/no-underscore-dangle": "off",
    // Fire-and-forget notification sends intentionally `.catch()` outside
    // the awaited call chain.
    "promise/no-promise-in-callback": "off",
    "import/no-named-as-default-member": "off"
  },
  "overrides": [
    {
      // Config is read once, under src/config, and passed down validated.
      // Only bootstrap/container.ts names a transport package, and no app
      // imports a WhatsApp library.
      "files": ["apps/*/src/**"],
      "rules": {
        "node/no-process-env": "error",
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": ["whatsapp-web.js", "@whiskeysockets/baileys"],
            "patterns": [
              "whatsapp-web.js/**",
              "@whiskeysockets/baileys/**",
              "@bot-whatsapp/whatsapp-*",
              "@bot-whatsapp/whatsapp-*/**"
            ]
          }
        ]
      }
    },
    {
      // domain and application depend on ports, never on adapters.
      "files": ["apps/*/src/domain/**", "apps/*/src/application/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": ["whatsapp-web.js", "@whiskeysockets/baileys"],
            "patterns": [
              "whatsapp-web.js/**",
              "@whiskeysockets/baileys/**",
              "@bot-whatsapp/whatsapp-*",
              "@bot-whatsapp/whatsapp-*/**",
              "**/infrastructure",
              "**/infrastructure/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/*/src/bootstrap/container.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": ["whatsapp-web.js", "@whiskeysockets/baileys"],
            "patterns": ["whatsapp-web.js/**", "@whiskeysockets/baileys/**"]
          }
        ]
      }
    },
    {
      "files": ["apps/*/src/config/**"],
      "rules": { "node/no-process-env": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**"]
}
